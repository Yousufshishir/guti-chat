path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Profile returned (or locked summary if not a friend)","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/UserProfile"},{"$ref":"#/components/schemas/LockedUserSummary"}]}}}},"400":{"description":"Cannot request own profile via this route","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Blocked","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"User not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/users/keys/{id}":{"get":{"tags":["Social"],"summary":"Fetch user's public key (E2EE key exchange)","security":[{"BearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Public key returned","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string"},"data":{"type":"object","properties":{"publicKey":{"type":"string"}}}}}}}},"403":{"description":"Blocked relationship","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"User or key not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/users/toggle-profile-lock":{"put":{"tags":["Social"],"summary":"Toggle profile lock (Facebook-style)","security":[{"BearerAuth":[]}],"responses":{"200":{"description":"Lock toggled","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string"},"isProfileLocked":{"type":"boolean"},"message":{"type":"string"}}}}}}}}},"/api/users/friends":{"get":{"tags":["Social"],"summary":"Get friends list","security":[{"BearerAuth":[]}],"responses":{"200":{"description":"List of friends","content":{"application/json":{"schema":{"type":"object","properties":