@"
# Dependencies
node_modules/

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Service Accounts & Keys
firebase-service-account.json
*-service-account.json
*serviceAccount*.json
supabase-*.json
*.pem
*.key
*.crt
*.p12

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/

# Build outputs
dist/
build/
out/

# Cache
.cache/
.parcel-cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temp
tmp/
temp/

# Firebase
.firebase/

# Optional
*.local

# MongoDB dumps
*.dump
*.bson
"@ | Out-File -FilePath .gitignore -Encoding utf8